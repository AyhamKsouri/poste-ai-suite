SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Leave empty to run with mocked AI responses (no API calls made).
# Set to a real key (from console.groq.com) to enable live Groq API calls for
# RAG answers and complaint triage. Free tier, no card required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DATABASE_URL=sqlite:///./data/poste.db
UPLOAD_DIR=./data/uploads

ADMIN_EMAIL=admin@poste.tn
ADMIN_PASSWORD=admin123

# Comma-separated list of allowed frontend origins. The default covers the
# native `npm run dev` workflow; docker-compose.yml overrides this for the
# frontend container's origin instead of editing source.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
